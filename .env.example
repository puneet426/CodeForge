# Copy this file to .env.local for local development (it is git-ignored),
# and add the same two variables in Netlify → Site configuration →
# Environment variables for the live site.
#
# Where to find them: Supabase dashboard → Project Settings → API
#   Project URL          → VITE_SUPABASE_URL
#   anon / public key    → VITE_SUPABASE_ANON_KEY
# (Never use the service_role key in the website.)

VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
